DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Vercel/Prisma Postgres can provide either of these names.
# POSTGRES_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# PRISMA_DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Naver Cloud Platform Maps API ncpKeyId.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID="YOUR_NAVER_MAP_CLIENT_ID"

# Naver Cloud Platform Maps API client secret for server-side reverse geocoding.
NAVER_MAP_CLIENT_SECRET="YOUR_NAVER_MAP_CLIENT_SECRET"
